.DS_Store

# Raw downloaded legislation XML -- large, and always re-fetchable from
# legislation.gov.uk's official XML endpoint via xml_parser.py, so no need to
# version-control it. (These also trip GitHub secret scanning as false
# positives: legislation.gov.uk's own "key-<32 hex>" amendment IDs happen to
# match the Mailgun API key pattern.)
data/raw/*.xml

__pycache__/
*.pyc

# Trained LoRA adapters. Only the bfloat16 copies of the two final adapters are
# version-controlled (67MB each). Excluded: the float32 originals, at 133MB each
# over GitHub's 100MB per-file limit, and the per-checkpoint optimizer state,
# about 8GB in total. See "Adapters" in README.md.
adapters/*
!adapters/legal_lora_v1_gpu_bf16/
!adapters/legal_lora_v2_gpu_bf16/
